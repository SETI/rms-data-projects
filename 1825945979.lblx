            <Modification_Detail>
                <modification_date>2025-06-11</modification_date>
                <version_id>1.1</version_id>
                <description>
                    Values have been corrected for start_date_time, stop_date_time,
                        cassini:start_time_doy, and cassini:stop_time_doy.
                    Updated cassini:mission_phase_name (for which multiple values are possible)
                        in order to provide consistency across multiple instrument data sets.
                    Inserted new Legacy_Metadata class to contain original values replaced
                        by the above corrections.
                    Updated values of fast_hk_item_name_1, fast_hk_item_name_2, fast_hk_item_name_3,
                        and fast_hk_item_name_4 for consistency with attribute definitions.
                    See urn:nasa:pds:cassini_vims_cruise:document:v2.0_modifications for details.
                </description>
            </Modification_Detail>
            <Modification_Detail>
                <modification_date>2020-03-29</modification_date>
                <version_id>1.0</version_id>
                <description>Initial PDS4 Version. Migrated from the PDS3 data product.</description>
            </Modification_Detail>
        </Modification_History>
